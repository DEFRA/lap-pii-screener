// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
  "name": "Existing Dockerfile",
  "build": {
    "context": "..",
    "dockerfile": "./Dockerfile"
  },
  "initializeCommand": ".devcontainer/init.sh",
  "postAttachCommand": "uv sync --all-extras && uv pip install pip",
  "mounts": [
    "source=.cache/sensitive-scanner,target=/home/node/.sensitive-scanner,type=bind",
    "source=.cache/uv,target=/home/node/.cache/uv,type=bind"
  ]
}
